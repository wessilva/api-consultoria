# ═══════════════════════════════════════════════════════
# EXEMPLO DE ARQUIVO .env
# Copie este arquivo para .env e preencha com seus valores
# ═══════════════════════════════════════════════════════

# Ambiente de execução (development, production, test)
NODE_ENV=development

# Porta do servidor
PORT=3333

# URL de conexão do PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/database?schema=public
DATABASE_URL=postgresql://postgres:admin@localhost:5432/dbconsultoria?schema=public

# Chave secreta para JWT (MÍNIMO 32 caracteres)
# IMPORTANTE: Gere uma chave forte em produção!
# Você pode usar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-key-with-at-least-32-characters-here-change-in-production

# Tempo de expiração do token JWT
# Formatos aceitos: 7d (7 dias), 24h (24 horas), 60m (60 minutos)
JWT_EXPIRES_IN=7d
